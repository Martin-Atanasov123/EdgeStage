<Project Sdk="MSTest.Sdk/4.5.1">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseVSTest>true</UseVSTest>
    <!-- Desktop integration tests create real WPF windows. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real settings files from earlier versions, for migration tests. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EdgeStage.Core\EdgeStage.Core.csproj" />
    <ProjectReference Include="..\..\src\EdgeStage\EdgeStage.csproj" />
  </ItemGroup>

</Project>
