<Window x:Class="EdgeStage.UI.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EdgeStage.UI"
        Title="EdgeStage Sidebar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        FontFamily="{StaticResource UiFont}">
    <!--
        AllowsTransparency (a per-pixel-alpha layered window) was chosen in the Phase 1 spike: DWM
        thumbnails render on it exactly, and its translucent charcoal looks identical whether or not
        the sidebar is the active window (the system Acrylic backdrop turns opaque grey when inactive).

        The window spans from the screen edge to just past the panel, so the panel can slide in from
        the edge. Fully transparent pixels of a layered window do not receive clicks.
    -->
    <Grid x:Name="Root" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>

        <!-- Soft shadow: three faint, static rounded layers (no blur effect, so nothing to re-rasterize per frame). -->
        <Border x:Name="Shadow3" CornerRadius="23" Background="#0B000000" IsHitTestVisible="False" />
        <Border x:Name="Shadow2" CornerRadius="20" Background="#10000000" IsHitTestVisible="False" />
        <Border x:Name="Shadow1" CornerRadius="17" Background="#1A000000" IsHitTestVisible="False" />

        <Border x:Name="Panel" CornerRadius="14" BorderThickness="1"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: type-to-search box and the Exposé button. -->
                <Grid x:Name="HeaderBar" Grid.Row="0" Height="36" Margin="8,8,8,0">
                    <Border x:Name="SearchBox" CornerRadius="8" Background="{DynamicResource FilterBarBrush}" Margin="0,0,42,0"
                            Cursor="IBeam" MouseLeftButtonUp="OnSearchBoxClicked" ToolTip="Type to search window titles and apps">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="FilterText" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Type to search" FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ExposeButton" HorizontalAlignment="Right" Width="36" Height="36"
                            Style="{StaticResource IconButton}" Click="OnExposeClicked"
                            ToolTip="Show all windows (Exposé)" AutomationProperties.Name="Show all windows">
                        <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                </Grid>

                <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource SlimScrollViewer}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" Focusable="False">
                    <ItemsControl x:Name="CardList" ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type ui:CardViewModel}">
                                <ui:PreviewCard Height="{DynamicResource SidebarCardHeight}" Margin="{DynamicResource CardSpacingMargin}"
                                                MouseEnter="OnCardMouseEnter" MouseMove="OnCardMouseEnter"
                                                MouseLeftButtonUp="OnCardClicked" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type ui:GroupHeaderViewModel}">
                                <Border Height="26" Margin="{DynamicResource CardSpacingMargin}" CornerRadius="6" Padding="8,0"
                                        Background="{DynamicResource GroupHeaderBrush}" Cursor="Hand"
                                        MouseLeftButtonUp="OnGroupHeaderClicked" ToolTip="Click to collapse or expand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                               Source="{Binding Icon, TargetNullValue={StaticResource GenericAppIcon}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding AppName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="11" Margin="8,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE70D;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                            <Setter Property="Text" Value="&#xE76C;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{Binding EmptyMessage}" FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
