<Window x:Class="EdgeStage.UI.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EdgeStage.UI"
        Title="EdgeStage"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        FontFamily="{StaticResource UiFont}">
    <!--
        AllowsTransparency (a per-pixel-alpha layered window) was chosen in the Phase 1 spike: DWM
        thumbnails render on it exactly, and its translucent charcoal looks identical whether or not
        the sidebar is the active window (the system Acrylic backdrop turns opaque grey when inactive).
    -->
    <Border x:Name="Panel" CornerRadius="14" BorderThickness="1"
            Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource SidebarBorderBrush}">
        <Grid>
            <ScrollViewer x:Name="Scroller" Style="{StaticResource SlimScrollViewer}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="False">
                <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}" Focusable="False"
                              Margin="{x:Static ui:SidebarWindow.ListMargin}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:PreviewCard Margin="0,0,0,8"
                                            MouseEnter="OnCardMouseEnter"
                                            MouseLeftButtonUp="OnCardClicked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Text="No other open windows" FontSize="13"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
