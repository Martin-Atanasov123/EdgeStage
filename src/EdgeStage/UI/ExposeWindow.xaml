<Window x:Class="EdgeStage.UI.ExposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EdgeStage.UI"
        Title="EdgeStage Exposé"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        FontFamily="{StaticResource UiFont}">
    <!--
        Full-monitor overlay (same layered-window setup as the sidebar, where DWM thumbnails were
        proven to render). The dim layer is translucent, so the desktop shows through dimmed; the
        cards' live previews are DWM thumbnails positioned over the cards' thumbnail hosts.
    -->
    <Grid x:Name="Root">
        <Rectangle x:Name="Dim" Fill="{DynamicResource ExposeDimBrush}" Opacity="0"
                   MouseLeftButtonUp="OnBackgroundClicked" />

        <Grid x:Name="Chrome">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="SearchBox" Grid.Row="0" HorizontalAlignment="Center" Width="380" Height="40"
                    Margin="0,28,0,8" CornerRadius="12" Background="{DynamicResource FilterBarBrush}" Opacity="0"
                    ToolTip="Type to search window titles and apps">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FilterText" Grid.Column="1" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Type to search windows" FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText" Grid.Column="2" FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="48,8,48,32" Style="{StaticResource SlimScrollViewer}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="False">
                <ItemsControl x:Name="CardList" ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ui:ExposeGridPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type ui:CardViewModel}">
                            <ui:PreviewCard ShowTitle="{DynamicResource ExposeShowTitles}" ShowIcon="{DynamicResource ExposeShowIcons}"
                                            MouseEnter="OnCardMouseEnter" MouseMove="OnCardMouseEnter"
                                            MouseLeftButtonUp="OnCardClicked" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type ui:GroupHeaderViewModel}">
                            <Border CornerRadius="8" Padding="12,0" Background="{DynamicResource GroupHeaderBrush}"
                                    Cursor="Hand" MouseLeftButtonUp="OnGroupHeaderClicked" ToolTip="Click to collapse or expand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE70D;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                        <Setter Property="Text" Value="&#xE76C;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Grid.Column="1" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Source="{Binding Icon, TargetNullValue={StaticResource GenericAppIcon}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding AppName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="12" Margin="10,0,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{Binding EmptyMessage}" FontSize="18"
                       Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
