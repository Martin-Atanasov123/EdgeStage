<Window x:Class="EdgeStage.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="EdgeStage settings"
        Icon="pack://application:,,,/EdgeStage;component/Assets/EdgeStage.ico"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="4,18,0,6" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="20,16,20,18">
        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/EdgeStage;component/Assets/EdgeStage.ico" Width="36" Height="36" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="EdgeStage" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Switch windows from live previews at the edge of the screen." Style="{StaticResource Hint}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="OPEN THE SIDEBAR" Style="{StaticResource SectionHeader}" />

        <Border Style="{StaticResource Row}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Keyboard shortcut" />
                        <TextBlock Text="Click the box, then press the new shortcut." Style="{StaticResource Hint}" />
                    </StackPanel>
                    <Border x:Name="HotkeyBox" Grid.Column="1" MinWidth="160" Height="32" CornerRadius="5" BorderThickness="1"
                            Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                            Focusable="True" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            AutomationProperties.Name="Keyboard shortcut"
                            MouseLeftButtonDown="OnHotkeyBoxClicked" GotKeyboardFocus="OnHotkeyBoxFocused"
                            LostKeyboardFocus="OnHotkeyBoxBlurred" PreviewKeyDown="OnHotkeyBoxKeyDown">
                        <TextBlock x:Name="HotkeyText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
                    </Border>
                </Grid>
                <Grid x:Name="HotkeyStatusRow" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0" />
                    <Button x:Name="SuggestButton" Grid.Column="1" Style="{StaticResource DarkButton}" Padding="10,3"
                            Margin="8,0,0,0" Visibility="Collapsed" Click="OnUseSuggestion" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Row}">
            <CheckBox x:Name="EdgeEnabled" Style="{StaticResource ToggleSwitch}" Checked="OnEdgeToggled" Unchecked="OnEdgeToggled">
                <StackPanel>
                    <TextBlock Text="Open when the pointer rests at the screen edge" />
                    <TextBlock Text="Turned off automatically while a full-screen app is running." Style="{StaticResource Hint}" />
                </StackPanel>
            </CheckBox>
        </Border>

        <Border Style="{StaticResource Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Screen edge" VerticalAlignment="Center" />
                <Border Grid.Column="1" CornerRadius="7" Background="{StaticResource ControlBrush}" Padding="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="EdgeLeft" Content="Left" GroupName="Edge" Style="{StaticResource Segment}" Checked="OnEdgeSideChanged" />
                        <RadioButton x:Name="EdgeRight" Content="Right" GroupName="Edge" Style="{StaticResource Segment}" Checked="OnEdgeSideChanged" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource Row}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Edge activation delay" />
                    <TextBlock x:Name="ActivationDelayText" Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
                <Slider x:Name="ActivationDelay" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1000"
                        TickFrequency="50" SmallChange="50" LargeChange="100" Margin="0,8,0,0"
                        AutomationProperties.Name="Edge activation delay in milliseconds"
                        ValueChanged="OnActivationDelayChanged" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Row}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hide after the pointer leaves" />
                    <TextBlock x:Name="DismissDelayText" Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
                <Slider x:Name="DismissDelay" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="2000"
                        TickFrequency="50" SmallChange="50" LargeChange="200" Margin="0,8,0,0"
                        AutomationProperties.Name="Hide delay in milliseconds"
                        ValueChanged="OnDismissDelayChanged" />
            </StackPanel>
        </Border>

        <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeader}" />

        <Border Style="{StaticResource Row}">
            <CheckBox x:Name="HoldToSwitch" Style="{StaticResource ToggleSwitch}" Checked="OnBehaviorToggled" Unchecked="OnBehaviorToggled">
                <StackPanel>
                    <TextBlock Text="Hold to switch (like Alt+Tab)" />
                    <TextBlock Text="Keep the shortcut's modifier keys held and press its key again to step through windows; release to switch. Needs a shortcut with a modifier." Style="{StaticResource Hint}" />
                </StackPanel>
            </CheckBox>
        </Border>

        <Border Style="{StaticResource Row}">
            <CheckBox x:Name="OnlyMonitor" Style="{StaticResource ToggleSwitch}" Checked="OnBehaviorToggled" Unchecked="OnBehaviorToggled">
                <StackPanel>
                    <TextBlock Text="Only windows on this monitor" />
                    <TextBlock Text="List just the windows that are on the screen the sidebar opens on." Style="{StaticResource Hint}" />
                </StackPanel>
            </CheckBox>
        </Border>

        <TextBlock Text="HIDDEN APPS" Style="{StaticResource SectionHeader}" />

        <Border Style="{StaticResource Row}">
            <StackPanel>
                <TextBlock Text="Windows of these apps never appear in the sidebar." />
                <TextBlock x:Name="HiddenAppsHint" Style="{StaticResource Hint}"
                           Text="Right-click a card and choose “Never show …”, or type a program name such as spotify." />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewApp" Height="30" Padding="8,4" VerticalContentAlignment="Center"
                             Background="{StaticResource ControlBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                             BorderBrush="{StaticResource ControlBorderBrush}" CaretBrush="{StaticResource PrimaryTextBrush}"
                             AutomationProperties.Name="Program name to hide" KeyDown="OnNewAppKeyDown" />
                    <Button Grid.Column="1" Content="Hide app" Style="{StaticResource DarkButton}" Margin="8,0,0,0" Padding="12,4" Click="OnAddHiddenApp" />
                </Grid>
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Focusable="False">
                    <StackPanel x:Name="HiddenAppsList" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}" />

        <Border Style="{StaticResource Row}">
            <CheckBox x:Name="StartWithWindows" Style="{StaticResource ToggleSwitch}" Checked="OnStartupToggled" Unchecked="OnStartupToggled">
                <StackPanel>
                    <TextBlock Text="Start with Windows" />
                    <TextBlock x:Name="StartupHint" Text="Starts EdgeStage in the background when you sign in." Style="{StaticResource Hint}" />
                </StackPanel>
            </CheckBox>
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Changes are saved automatically." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0" />
            <Button Grid.Column="1" Content="Open log folder" Style="{StaticResource DarkButton}" Margin="0,0,8,0" Click="OnOpenLogs" />
            <Button Grid.Column="2" Content="Close" Style="{StaticResource DarkButton}" IsCancel="True" Click="OnClose" />
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>
