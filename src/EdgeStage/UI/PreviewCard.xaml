<UserControl x:Class="EdgeStage.UI.PreviewCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EdgeStage.UI"
             d:DataContext="{d:DesignInstance ui:CardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <ui:NullToVisibilityConverter x:Key="NullToVisible" Invert="True" />
    </UserControl.Resources>

    <Border x:Name="Root" CornerRadius="{DynamicResource CardCornerRadius}" BorderThickness="1.5"
            Padding="{DynamicResource CardPaddingThickness}"
            Cursor="Hand" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderActiveBrush}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="20" />
                <RowDefinition x:Name="GapRow" Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                ThumbHost marks where the live DWM thumbnail is composited. DWM draws ABOVE this
                element, so its content (the large icon) is only visible when no thumbnail is
                drawn: preview unavailable, or DWM has nothing for the window.
            -->
            <Border x:Name="ThumbHost" Grid.Row="2" CornerRadius="{DynamicResource ThumbCornerRadius}" Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Width="40" Height="40" Opacity="0.6" Source="{Binding Icon}"
                           Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                    <Image Width="32" Height="32" Source="{StaticResource GenericAppIcon}"
                           Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
                    <TextBlock Text="Preview unavailable" Margin="0,8,0,0" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"
                               Visibility="{Binding PreviewUnavailable, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Grid x:Name="TitleBar" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IconColumn" Width="16" />
                    <ColumnDefinition x:Name="IconGapColumn" Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="TitleIcon" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding Icon, TargetNullValue={StaticResource GenericAppIcon}}" />

                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}" ToolTip="{Binding Title}"
                           Visibility="{Binding Notice, Converter={StaticResource NullToVisible}}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource WarningTextBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Notice}" ToolTip="{Binding Notice}"
                           Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource BadgeBackgroundBrush}"
                            Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Minimized: the preview shows the window as it was when it was minimized.">
                        <TextBlock Text="Minimized" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                    <Ellipse Width="6" Height="6" Margin="6,0,0,0" Fill="{DynamicResource AccentBrush}"
                             ToolTip="Current window"
                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Appears while the pointer is over the card; asks the window to close like its own X button. -->
                <Button x:Name="CloseButton" Grid.Column="4" Width="20" Height="20" Margin="6,0,0,0"
                        Click="OnCloseClicked" Focusable="False" Cursor="Arrow"
                        ToolTip="Close window" AutomationProperties.Name="Close window">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#CCC42B1C" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
