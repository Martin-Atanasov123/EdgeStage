<?xml version="1.0" encoding="utf-8"?>
<!-- One executable that runs on any Windows x64 machine without installing .NET. WPF does not support
     trimming. Single-file compression is OFF on purpose: compressed assemblies are inflated into private
     memory at startup, which measured ~119 MB private vs ~63 MB uncompressed. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishDir>..\..\artifacts\SelfContained\</PublishDir>
  </PropertyGroup>
</Project>
