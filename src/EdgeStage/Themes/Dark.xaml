<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: dark charcoal surfaces, restrained translucency, one accent. -->
    <Color x:Key="SidebarBackgroundColor">#EB1B1B1D</Color>
    <Color x:Key="AccentColor">#FF60CDFF</Color>

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF323236" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="#FF161618" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFFFB86B" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#1FFFFFFF" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Fallback app glyph shown when a window exposes no icon. -->
    <DrawingImage x:Key="GenericAppIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#59FFFFFF">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="1,1,14,14" RadiusX="3" RadiusY="3" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="#8CFFFFFF" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Slim, unobtrusive scrollbar. -->
    <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="2" Background="#55FFFFFF" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="0,12,2,12">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollBarThumb}" Width="4" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SlimScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
